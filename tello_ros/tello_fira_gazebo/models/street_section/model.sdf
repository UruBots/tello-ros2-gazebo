<?xml version="1.0" ?>
<!--
  FIRA Air - Street Section Model
  Modular street piece for arena construction
  Default: 2m wide x 6m long with dashed center line
  
  Competition spec: 20cm wide streets, but scaled up for visibility
-->
<sdf version="1.9">
  <model name="street_section">
    <static>true</static>
    <link name="link">
      
      <!-- Street surface (white/light gray) -->
      <visual name="street_surface">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>2 6 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
      
      <!-- Street edges (darker) -->
      <visual name="edge_left">
        <pose>-1.02 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 6 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      
      <visual name="edge_right">
        <pose>1.02 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 6 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      
      <!-- Center dashed line -->
      <visual name="dash_1">
        <pose>0 -2.5 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <visual name="dash_2">
        <pose>0 -1.5 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <visual name="dash_3">
        <pose>0 -0.5 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <visual name="dash_4">
        <pose>0 0.5 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <visual name="dash_5">
        <pose>0 1.5 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <visual name="dash_6">
        <pose>0 2.5 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
    </link>
  </model>
</sdf>
