<?xml version="1.0" ?>
<!--
  FIRA Air - QR Marker Model with Texture Support
  20cm x 20cm marker using actual QR code texture
  
  Usage: Set QR_TEXTURE environment variable or copy specific QR to qr_code.png
-->
<sdf version="1.9">
  <model name="qr_marker_textured">
    <static>true</static>
    <link name="link">
      
      <!-- QR code surface with texture -->
      <visual name="qr_surface">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://qr_marker/textures/qr_c.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      
    </link>
  </model>
</sdf>
