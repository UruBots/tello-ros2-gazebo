<?xml version="1.0" ?>
<!--
  FIRA Air - Delivery Marker Model
  First aid delivery target with red cross on white background
-->
<sdf version="1.9">
  <model name="delivery_marker">
    <static>true</static>
    <link name="link">
      
      <!-- White base -->
      <visual name="base">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>1 1 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>
      
      <!-- Red cross - Vertical bar -->
      <visual name="cross_vertical">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.7 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.2 0.0 0.0 1</specular>
        </material>
      </visual>
      
      <!-- Red cross - Horizontal bar -->
      <visual name="cross_horizontal">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.15 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.2 0.0 0.0 1</specular>
        </material>
      </visual>
      
      <!-- Collision -->
      <collision name="collision">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>1 1 0.01</size>
          </box>
        </geometry>
      </collision>
      
    </link>
  </model>
</sdf>
