<?xml version="1.0" ?>
<!--
  FIRA Air - Autonomous Race Arena
  3D drone race through magenta gates following a guide line.
  Track: ~42m loop, 5 gates (4 vertical + 1 horizontal), 0.5x0.5m blue-H pad.
  Guide line: 5cm wide dark line on light gray ground.
  Optical flow patches: scattered colored rectangles for visual odometry.

  Track waypoints (clockwise loop):
    P0(0,-6)  P1(3,-5)  P2/G1(5.5,-2.5)  P3(6.5,1)
    P4/G2(6,4)  P5(4.5,6.5)  P6/G3(1.5,8)  P7(-2,7.5)
    P8/G4(-5,5.5)  P9(-6.5,2.5)  P10/G5(-5.5,-1)
    P11(-3.5,-4)  P12(-1,-5.5)  -> P0
-->
<sdf version="1.7">
  <world name="fira_autonomous_race">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.2 0.2 0.3 1</background>
      <shadows>true</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Indoor arena lighting -->
    <light type="directional" name="overhead">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <light type="point" name="fill_1">
      <pose>5 5 8 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation><range>40</range><constant>0.5</constant></attenuation>
    </light>

    <light type="point" name="fill_2">
      <pose>-5 -5 8 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation><range>40</range><constant>0.5</constant></attenuation>
    </light>

    <!-- Ground plane: light gray for high contrast with dark guide line -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================ -->
    <!-- TAKEOFF / LANDING PAD: 0.5x0.5m blue H           -->
    <!-- Position: (0, -6) at track start/finish           -->
    <!-- ================================================ -->
    <model name="race_pad">
      <static>true</static>
      <pose>0 -6 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad_base">
          <geometry><box><size>0.5 0.5 0.002</size></box></geometry>
          <material><ambient>0.1 0.1 0.7 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
        </visual>
        <visual name="h_left">
          <pose>-0.12 0 0.002 0 0 0</pose>
          <geometry><box><size>0.05 0.3 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_right">
          <pose>0.12 0 0.002 0 0 0</pose>
          <geometry><box><size>0.05 0.3 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_mid">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><box><size>0.3 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><box><size>0.5 0.5 0.01</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================================================ -->
    <!-- GUIDE LINE: 5cm wide dark line on ground             -->
    <!-- 13 straight segments connecting track waypoints   -->
    <!-- ================================================ -->

    <!-- Segment 0: P0(0,-6) -> P1(3,-5) -->
    <model name="gl_0">
      <static>true</static>
      <pose>1.5 -5.5 0.001 0 0 0.3217</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.162 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 1: P1(3,-5) -> P2(5.5,-2.5) -->
    <model name="gl_1">
      <static>true</static>
      <pose>4.25 -3.75 0.001 0 0 0.7854</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.536 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 2: P2(5.5,-2.5) -> P3(6.5,1) -->
    <model name="gl_2">
      <static>true</static>
      <pose>6.0 -0.75 0.001 0 0 1.2925</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.640 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 3: P3(6.5,1) -> P4(6,4) -->
    <model name="gl_3">
      <static>true</static>
      <pose>6.25 2.5 0.001 0 0 1.7359</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.041 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 4: P4(6,4) -> P5(4.5,6.5) -->
    <model name="gl_4">
      <static>true</static>
      <pose>5.25 5.25 0.001 0 0 2.1112</pose>
      <link name="l"><visual name="v"><geometry><box><size>2.915 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 5: P5(4.5,6.5) -> P6(1.5,8) -->
    <model name="gl_5">
      <static>true</static>
      <pose>3.0 7.25 0.001 0 0 2.6779</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.354 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 6: P6(1.5,8) -> P7(-2,7.5) -->
    <model name="gl_6">
      <static>true</static>
      <pose>-0.25 7.75 0.001 0 0 -3.0002</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.536 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 7: P7(-2,7.5) -> P8(-5,5.5) -->
    <model name="gl_7">
      <static>true</static>
      <pose>-3.5 6.5 0.001 0 0 -2.5536</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.606 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 8: P8(-5,5.5) -> P9(-6.5,2.5) -->
    <model name="gl_8">
      <static>true</static>
      <pose>-5.75 4.0 0.001 0 0 -2.0344</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.354 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 9: P9(-6.5,2.5) -> P10(-5.5,-1) -->
    <model name="gl_9">
      <static>true</static>
      <pose>-6.0 0.75 0.001 0 0 -1.2925</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.640 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 10: P10(-5.5,-1) -> P11(-3.5,-4) -->
    <model name="gl_10">
      <static>true</static>
      <pose>-4.5 -2.5 0.001 0 0 -0.9828</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.606 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 11: P11(-3.5,-4) -> P12(-1,-5.5) -->
    <model name="gl_11">
      <static>true</static>
      <pose>-2.25 -4.75 0.001 0 0 -0.5404</pose>
      <link name="l"><visual name="v"><geometry><box><size>2.915 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Segment 12: P12(-1,-5.5) -> P0(0,-6) closing the loop -->
    <model name="gl_12">
      <static>true</static>
      <pose>-0.5 -5.75 0.001 0 0 -0.4636</pose>
      <link name="l"><visual name="v"><geometry><box><size>1.118 0.05 0.001</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- ================================================ -->
    <!-- RACE GATES (Magenta) — FIRA spec compliant        -->
    <!-- Vertical: 2 posts + top/bottom bars               -->
    <!--   Frame: 1.0m W x 0.7m H, opening 0.9m x 0.6m   -->
    <!--   Post height (ground→frame): 0.65m               -->
    <!-- Horizontal: 4 posts + horizontal square frame     -->
    <!--   Posts: 0.9m x 0.9m, frame at 1.3m height        -->
    <!-- Gate yaw = approach direction (drone flies thru X) -->
    <!-- Min clearance between gates: >6m (rule: >2m)      -->
    <!-- ================================================ -->

    <!-- GATE 1 (Vertical) at P2(5.5, -2.5), approach yaw 0.7854 rad (45 deg) -->
    <model name="gate_1">
      <static>true</static>
      <pose>5.5 -2.5 0 0 0 0.7854</pose>
      <link name="link">
        <visual name="post_l">
          <pose>0 0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_r">
          <pose>0 -0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_top">
          <pose>0 0 1.325 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_bot">
          <pose>0 0 0.675 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <collision name="post_l_col"><pose>0 0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
        <collision name="post_r_col"><pose>0 -0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- GATE 2 (Vertical) at P4(6.0, 4.0), approach yaw 1.7359 rad (99 deg) -->
    <model name="gate_2">
      <static>true</static>
      <pose>6.0 4.0 0 0 0 1.7359</pose>
      <link name="link">
        <visual name="post_l">
          <pose>0 0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_r">
          <pose>0 -0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_top">
          <pose>0 0 1.325 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_bot">
          <pose>0 0 0.675 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <collision name="post_l_col"><pose>0 0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
        <collision name="post_r_col"><pose>0 -0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- GATE 3 (Horizontal) at P6(1.5, 8.0), approach yaw 2.6779 rad (153 deg) -->
    <!-- 4 posts 0.9m x 0.9m square, horizontal frame at 1.3m; drone flies under -->
    <model name="gate_3">
      <static>true</static>
      <pose>1.5 8.0 0 0 0 2.6779</pose>
      <link name="link">
        <visual name="post_fl">
          <pose>0.45 0.45 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_fr">
          <pose>0.45 -0.45 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_bl">
          <pose>-0.45 0.45 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_br">
          <pose>-0.45 -0.45 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="frame_f">
          <pose>0.45 0 1.3 0 0 0</pose>
          <geometry><box><size>0.05 0.95 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="frame_b">
          <pose>-0.45 0 1.3 0 0 0</pose>
          <geometry><box><size>0.05 0.95 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="frame_l">
          <pose>0 0.45 1.3 0 0 0</pose>
          <geometry><box><size>0.95 0.05 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="frame_r">
          <pose>0 -0.45 1.3 0 0 0</pose>
          <geometry><box><size>0.95 0.05 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <collision name="post_fl_col"><pose>0.45 0.45 0.65 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry></collision>
        <collision name="post_fr_col"><pose>0.45 -0.45 0.65 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry></collision>
        <collision name="post_bl_col"><pose>-0.45 0.45 0.65 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry></collision>
        <collision name="post_br_col"><pose>-0.45 -0.45 0.65 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry></collision>
        <collision name="frame_f_col"><pose>0.45 0 1.3 0 0 0</pose><geometry><box><size>0.05 0.95 0.05</size></box></geometry></collision>
        <collision name="frame_b_col"><pose>-0.45 0 1.3 0 0 0</pose><geometry><box><size>0.05 0.95 0.05</size></box></geometry></collision>
        <collision name="frame_l_col"><pose>0 0.45 1.3 0 0 0</pose><geometry><box><size>0.95 0.05 0.05</size></box></geometry></collision>
        <collision name="frame_r_col"><pose>0 -0.45 1.3 0 0 0</pose><geometry><box><size>0.95 0.05 0.05</size></box></geometry></collision>
      </link>
    </model>

    <!-- GATE 4 (Vertical) at P8(-5.0, 5.5), approach yaw -2.5536 rad (214 deg) -->
    <model name="gate_4">
      <static>true</static>
      <pose>-5.0 5.5 0 0 0 -2.5536</pose>
      <link name="link">
        <visual name="post_l">
          <pose>0 0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_r">
          <pose>0 -0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_top">
          <pose>0 0 1.325 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_bot">
          <pose>0 0 0.675 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <collision name="post_l_col"><pose>0 0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
        <collision name="post_r_col"><pose>0 -0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- GATE 5 (Vertical) at P10(-5.5, -1.0), approach yaw -1.2925 rad (-74 deg) -->
    <model name="gate_5">
      <static>true</static>
      <pose>-5.5 -1.0 0 0 0 -1.2925</pose>
      <link name="link">
        <visual name="post_l">
          <pose>0 0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="post_r">
          <pose>0 -0.45 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_top">
          <pose>0 0 1.325 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <visual name="bar_bot">
          <pose>0 0 0.675 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.05</size></box></geometry>
          <material><ambient>0.85 0.0 0.85 1</ambient><diffuse>1.0 0.0 1.0 1</diffuse></material>
        </visual>
        <collision name="post_l_col"><pose>0 0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
        <collision name="post_r_col"><pose>0 -0.45 0.675 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.35</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- ================================================ -->
    <!-- DIRECTION MARKERS (Green, max 20x20cm)            -->
    <!-- Placed on guide line, ≤50cm from nearest gate     -->
    <!-- point. Arrow shape (shaft + head) indicates the   -->
    <!-- correct approach direction for each gate.         -->
    <!-- To reverse race direction: rotate each marker     -->
    <!-- 180° (add π to yaw) and reposition to the        -->
    <!-- opposite side of its gate.                        -->
    <!-- ================================================ -->

    <!-- Marker G3: 0.30m before Gate 3 (horizontal) along approach -->
    <model name="marker_g3">
      <static>true</static>
      <pose>1.768 7.866 0.003 0 0 2.6779</pose>
      <link name="link">
        <visual name="shaft">
          <pose>-0.03 0 0 0 0 0</pose>
          <geometry><box><size>0.12 0.05 0.001</size></box></geometry>
          <material><ambient>0.0 0.75 0.0 1</ambient><diffuse>0.0 0.95 0.0 1</diffuse></material>
        </visual>
        <visual name="head">
          <pose>0.055 0 0 0 0 0</pose>
          <geometry><box><size>0.05 0.11 0.001</size></box></geometry>
          <material><ambient>0.0 0.75 0.0 1</ambient><diffuse>0.0 0.95 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

